root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Matches .clang-format: IndentWidth=4, ColumnLimit=100, UseTab=Never
[*.{c,h,cc,cpp,cxx,hpp,hxx,ipp,inl}]
indent_style = space
indent_size = 4
max_line_length = 100

[meson.build]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
