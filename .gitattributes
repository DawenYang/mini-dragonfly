# Auto-detect text files and normalize to LF in the repo
* text=auto eol=lf

# Explicit source types
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.cc  text eol=lf
*.c   text eol=lf
*.build text eol=lf
meson.build text eol=lf
meson_options.txt text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary / generated, never diff or convert
*.png binary
*.jpg binary
*.ico binary
